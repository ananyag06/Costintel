# Database Configuration
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cost_intelligence

# Application Settings
APP_NAME=Cloud Cost Intelligence Platform
ENVIRONMENT=development
DEBUG=True
API_PREFIX=/api

# CORS Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Cloud Collector Mode: "simulated" or "aws"
CLOUD_COLLECTOR_MODE=simulated

# AWS Configuration (required if CLOUD_COLLECTOR_MODE=aws)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_PRICING_REGION=us-east-1
AWS_USE_PRICING_API=true
AWS_METRIC_PERIOD_SECONDS=300
AWS_METRIC_LOOKBACK_MINUTES=60

# Pricing Configuration
EC2_HOURLY_RATE=0.096
LAMBDA_REQUEST_COST_PER_MILLION=0.20
LAMBDA_DURATION_COST_PER_GB_SECOND=0.0000166667
S3_STORAGE_COST_PER_GB_MONTH=0.023

# Anomaly Detection Thresholds
LOW_CPU_THRESHOLD=5.0
HIGH_REQUEST_SPIKE_MULTIPLIER=3.0
COST_THRESHOLD_FOR_STOP=1.0

# Optimization Settings
AUTO_APPLY_OPTIMIZATIONS=True
DRY_RUN_OPTIMIZATIONS=True

# Scheduler Configuration
SCHEDULER_ENABLED=True
SCHEDULER_INTERVAL_SECONDS=20
DEFAULT_METRIC_WINDOW=200
ANOMALY_MIN_TRAINING_POINTS=12
ISOLATION_FOREST_CONTAMINATION=0.08

# Hybrid Anomaly Model Weights
ANOMALY_AE_WEIGHT=0.4
ANOMALY_IF_WEIGHT=0.4
ANOMALY_RULE_WEIGHT=0.2

# Anomaly Detector Configuration
ANOMALY_RETRAIN_INTERVAL=20
ANOMALY_DYNAMIC_THRESHOLD_SIGMA=3.0

# xAI/Grok Integration (IMPORTANT - Required for insights generation)
# Get your API key from https://console.x.ai/
XAI_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-2-latest
INSIGHTS_CACHE_TTL=3600
ENABLE_INSIGHTS_GENERATION=True
